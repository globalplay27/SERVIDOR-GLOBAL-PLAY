PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
DATA_DIR=./data
PANEL_BRAND=NEXUS AI Agent Central

# Integrações administrativas futuras.
# Não coloque chaves reais no GitHub.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RAILWAY_API_TOKEN=
OPENAI_ADMIN_KEY=

# No Railway, adicione um volume e use:
# DATA_DIR=/data

# Portal do cliente: credenciais independentes do painel Master.
# Para um único cliente:
CLIENT_PORTAL_CLIENT_ID=ragnar-one
CLIENT_PORTAL_USERNAME=
CLIENT_PORTAL_PASSWORD=

# Para múltiplos clientes, use JSON e mantenha as senhas apenas no Railway:
# CLIENT_PORTAL_ACCOUNTS=[{"clientId":"ragnar-one","username":"cliente","password":"senha-forte"}]


# Trailer Finder (The Movie Database)
# Crie um token gratuito no TMDB e configure um dos dois:
TMDB_API_TOKEN=
TMDB_API_KEY=
