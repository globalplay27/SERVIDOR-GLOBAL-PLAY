PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
DATA_DIR=./data
PANEL_BRAND=Servidor Nexus

# Integrações administrativas.
# Nunca coloque valores reais no GitHub.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OPENAI_ADMIN_KEY=

# Cloudflare migration: estes valores devem ser configurados como Secrets.
# Todos os clientes, exceto Ragnar:
OPENAI_API_KEY_SHARED=
# Exclusivo do cliente ragnar-one:
OPENAI_API_KEY_RAGNAR=
RAGNAR_CLIENT_ID=ragnar-one

# Portal do cliente: credenciais independentes do painel Master.
CLIENT_PORTAL_CLIENT_ID=ragnar-one
CLIENT_PORTAL_USERNAME=
CLIENT_PORTAL_PASSWORD=

# Para múltiplos clientes, mantenha senhas apenas no ambiente/Secrets:
# CLIENT_PORTAL_ACCOUNTS=[{"clientId":"ragnar-one","username":"cliente","password":"senha-forte"}]

# Trailer Finder (The Movie Database)
TMDB_API_TOKEN=
TMDB_API_KEY=

# Legado Railway: mantido somente durante a fase de transição.
# Não é necessário no runtime final do Cloudflare.
RAILWAY_API_TOKEN=
