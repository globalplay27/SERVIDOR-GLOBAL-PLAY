{
  "name": "servidor-nexus-cloudflare",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "d1:migrations:list": "wrangler d1 migrations list servidor-nexus",
    "d1:migrations:apply": "wrangler d1 migrations apply servidor-nexus --remote",
    "d1:migrations:apply:local": "wrangler d1 migrations apply servidor-nexus --local"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.0.29"
  }
}
