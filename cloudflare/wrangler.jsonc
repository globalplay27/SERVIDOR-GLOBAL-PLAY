{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "servidor-nexus",
  "main": "src/index.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_NAME": "Servidor Nexus",
    "RAGNAR_CLIENT_ID": "ragnar-one"
  },
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/login",
      "/master*",
      "/portal-login",
      "/api/*",
      "/index.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "servidor-nexus",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "servidor-nexus-media"
    }
  ]
}
