{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "servidor-nexus",
  "main": "src/index.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_NAME": "Servidor Nexus",
    "RAGNAR_CLIENT_ID": "ragnar-one"
  },
  "secrets": {
    "required": [
      "OPENAI_API_KEY_SHARED",
      "OPENAI_API_KEY_RAGNAR",
      "NEXUS_SECRET_KEY"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "servidor-nexus",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "servidor-nexus-media"
    }
  ]
}
