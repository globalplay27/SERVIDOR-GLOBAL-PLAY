{
  // deploy-refresh: 2026-09-26-strict-movie-series-catalog
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "servidor-nexus",
  "main": "src/index.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "APP_NAME": "Servidor Nexus",
    "RAGNAR_CLIENT_ID": "ragnar-one",
    "CLOUDFLARE_AUTOMATION_ACTIVE": "false",
    "NEXUS_AI_PROVIDER": "workers-first",
    "NEXUS_OPENAI_DAILY_TOKEN_LIMIT": "30000",
    "NEXUS_OPENAI_MAX_OUTPUT_TOKENS": "1200",
    "RAILWAY_VIDEO_BRIDGE_URL": "https://servidor-global-play-production.up.railway.app"
  },
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/login",
      "/master*",
      "/portal-login",
      "/api/*",
      "/index.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "servidor-nexus",
      "database_id": "3d440c4a-8925-4526-8d29-03f9eb227d60",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "servidor-nexus-media"
    }
  ]
}
